---
# Prioritize correctness, undefined behavior, portability, and inexpensive
# modernization. The exclusions avoid high-noise rules for short contest code.
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-*,
  readability-*,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-narrowing-conversions,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  misc-misplaced-const,
  misc-redundant-expression,
  misc-static-assert,
  misc-unconventional-assign-operator,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -modernize-avoid-c-arrays,
  -modernize-macro-to-enum,
  -modernize-use-auto,
  -modernize-use-designated-initializers,
  -modernize-use-std-format,
  -modernize-use-std-print,
  -modernize-use-trailing-return-type,
  -readability-avoid-nested-conditional-operator,
  -readability-avoid-const-params-in-decls,
  -readability-braces-around-statements,
  -readability-convert-member-functions-to-static,
  -readability-else-after-return,
  -readability-enum-initial-value,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-length,
  -readability-identifier-naming,
  -readability-implicit-bool-conversion,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-non-const-parameter,
  -readability-operators-representation,
  -readability-qualified-auto,
  -readability-trailing-comma,
  -readability-trivial-switch,
  -readability-uppercase-literal-suffix

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
SystemHeaders: false
FormatStyle: file
ExtraArgs:
  - -std=c++23
  - -Iinclude

CheckOptions:
  bugprone-argument-comment.CommentBoolLiterals: true
  bugprone-assert-side-effect.AssertMacros: assert
  bugprone-misplaced-widening-cast.CheckImplicitCasts: true
  modernize-loop-convert.MaxCopySize: 16
  modernize-loop-convert.MinConfidence: reasonable
  modernize-use-nullptr.NullMacros: 'NULL'
  performance-for-range-copy.WarnOnAllAutoCopies: true
...
